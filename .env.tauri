# ============================================================
# Tauri 桌面端专用环境变量（mode=tauri，由 `pnpm run build:tauri` 加载）
# ------------------------------------------------------------
# 优先级：进程环境变量 > .env.tauri.local > .env.tauri > .env
#
# 平台专属地址请写入 .env.tauri.local（该文件已被 .gitignore 的 *.local 规则忽略，
# 不会推送到仓库，避免 Mac 的隧道地址污染 Windows 构建）。
#
# 本文件中的默认值面向 Windows 构建（直连阿里云 ECS 公网 IP），
# 因此 Windows 端只需 `git pull` + `pnpm tauri build`，无需手动设置任何变量。
# ============================================================
VITE_API_BASE_URL=http://121.43.110.135:8000/api/v1
VITE_WS_BASE_URL=ws://121.43.110.135:8000/api/v1
VITE_APP_VERSION=0.1.22
